@model InventoryManagement.Web.ViewModels.ProductListModel
@{ ViewData["Title"] = "Products"; }
<div class="page-heading">
    <div><div class="eyebrow">YOUR INVENTORY, AT A GLANCE</div><h1>Products</h1><p>Manage your catalog and keep stock levels in sight.</p></div>
    <a class="btn btn-primary" asp-action="Create"><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus" /></svg>Add product</a>
</div>
<section class="panel">
    <div class="panel-toolbar">
        <div class="section-title"><span class="section-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#box" /></svg></span><div><h2>Product directory <span class="count-badge">@Model.Products.Count</span></h2><p>Explore your products and their availability.</p></div></div>
        <form method="get" class="search-form" role="search">
            <div class="search-input"><svg class="icon" aria-hidden="true"><use href="/icons.svg#search" /></svg><label class="visually-hidden" for="search">Search SKU or name</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search SKU or name…" maxlength="200" /></div>
            <button class="btn btn-outline-primary" type="submit">Search</button>
            @if (!string.IsNullOrEmpty(Model.Search)) { <a asp-action="Index" class="btn btn-light">Clear</a> }
        </form>
    </div>
    @if (Model.Products.Count == 0)
    {
        <div class="empty-state"><span class="empty-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#search" /></svg></span><h3>No products found</h3><p>Try another search or add your first product to get started.</p><a asp-action="Create" class="btn btn-primary">Add product</a></div>
    }
    else
    {
        <div class="table-responsive" tabindex="0" role="region" aria-label="Product directory table">
            <table class="table align-middle product-table mb-0">
                <thead><tr><th scope="col">Product</th><th scope="col" class="text-end">Current stock</th><th scope="col" class="text-end">Reorder level</th><th scope="col">Status</th><th scope="col" class="text-end">Actions</th></tr></thead>
                <tbody>
                @foreach (var p in Model.Products)
                {
                    <tr class="@(p.IsLowStock ? "low-stock-row" : "")">
                        <td><div class="product-cell"><span class="product-avatar"><svg class="icon" aria-hidden="true"><use href="/icons.svg#box" /></svg></span><div><a class="product-name" asp-action="Details" asp-route-id="@p.Id">@p.Name</a><div class="sku">@p.Sku</div></div></div></td>
                        <td class="text-end"><div class="stock-number">@p.CurrentStock.ToString("N0") <span>units</span></div>@if (p.IsLowStock) { <span class="badge low-stock">Low stock</span> }</td>
                        <td class="text-end"><span class="reorder-number">@p.ReorderLevel</span></td>
                        <td><span class="badge @(p.IsActive ? "active-badge" : "inactive-badge")"><span class="badge-dot"></span>@(p.IsActive ? "Active" : "Inactive")</span></td>
                        <td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light" aria-label="View @p.Name">View<svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow" /></svg></a> <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm icon-button" aria-label="Edit @p.Name"><svg class="icon" aria-hidden="true"><use href="/icons.svg#edit" /></svg></a></td>
                    </tr>
                }
                </tbody>
            </table>
        </div>
        <div class="table-footer"><span>@Model.Products.Count products shown</span><span><span class="legend-dot"></span>Low stock: at or below reorder level</span></div>
    }
</section>
