@model InventoryManagement.Web.ViewModels.ProductDetailsModel
@using InventoryManagement.Domain.Enums
@{ ViewData["Title"] = Model.Product.Name; }
<a class="back-link" asp-action="Index">← All products</a><div class="page-heading"><div><div class="eyebrow">@Model.Product.Sku</div><h1>@Model.Product.Name</h1><span class="badge @(Model.Product.IsActive ? "active-badge" : "inactive-badge")">@(Model.Product.IsActive ? "Active" : "Inactive")</span></div><a asp-action="Edit" asp-route-id="@Model.Product.Id" class="btn btn-outline-primary">Edit product</a></div>
<div class="row g-4 mb-4"><div class="col-md-4"><section class="panel metric"><span class="eyebrow">CURRENT STOCK</span><div class="metric-value">@Model.Product.CurrentStock.ToString("N0") <small>units</small></div>@if (Model.Product.IsLowStock) { <span class="badge low-stock">Low stock · reorder recommended</span> } else { <span class="text-secondary small">Stock above reorder level</span> }</section></div><div class="col-md-8"><section class="panel metric h-100"><h2>Product information</h2><p class="description">@(string.IsNullOrWhiteSpace(Model.Product.Description) ? "No description provided." : Model.Product.Description)</p><div class="text-secondary small">Reorder level: <strong>@Model.Product.ReorderLevel units</strong> · Created @Model.Product.CreatedUtc.ToString("dd MMM yyyy") UTC</div></section></div></div>
<div class="row g-4"><div class="col-lg-8"><section class="panel"><div class="panel-toolbar"><div><h2>Movement history</h2><span class="text-secondary small">Newest first · all timestamps in UTC</span></div><span class="badge inactive-badge">@Model.History.Count entries</span></div>
@if (Model.History.Count == 0) { <div class="empty-state"><h3>No movements yet</h3><p>Record a Stock In to receive your first units.</p></div> }
else { <div class="table-responsive"><table class="table mb-0"><thead><tr><th>Date (UTC)</th><th>Type</th><th class="text-end">Quantity</th><th>Note</th></tr></thead><tbody>@foreach (var m in Model.History) { <tr><td class="text-nowrap">@m.CreatedUtc.ToString("dd MMM yyyy HH:mm:ss")</td><td><span class="badge @(m.Type == MovementType.In ? "active-badge" : "out-badge")">Stock @m.Type</span></td><td class="text-end fw-semibold">@m.Quantity.ToString("N0")</td><td class="note">@(m.Note ?? "—")</td></tr> }</tbody></table></div> }</section></div>
<div class="col-lg-4"><section class="panel movement-panel"><h2>Record movement</h2><p class="text-secondary small">Receive or issue stock. Every movement is kept in your history.</p>
<div asp-validation-summary="All" class="text-danger" role="alert"></div>
@if (Model.Product.IsActive) { <form asp-action="RecordMovement" asp-route-id="@Model.Product.Id" method="post"><input asp-for="Movement.RequestId" type="hidden" />
<div class="mb-3"><label asp-for="Movement.Type" class="form-label"></label><select asp-for="Movement.Type" class="form-select"><option value="1">Stock In — receive goods</option><option value="2">Stock Out — issue goods</option></select></div>
<div class="mb-3"><label asp-for="Movement.Quantity" class="form-label"></label><input asp-for="Movement.Quantity" class="form-control" min="1" /><span asp-validation-for="Movement.Quantity" class="text-danger"></span></div>
<div class="mb-4"><label asp-for="Movement.Note" class="form-label"></label><textarea asp-for="Movement.Note" class="form-control" rows="3" placeholder="Delivery or order reference (optional)"></textarea><span asp-validation-for="Movement.Note" class="text-danger"></span></div><button class="btn btn-primary w-100" type="submit">Record movement</button></form> }
else { <div class="alert alert-secondary">This product is inactive. Reactivate it to record stock movements.</div> }</section></div></div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
