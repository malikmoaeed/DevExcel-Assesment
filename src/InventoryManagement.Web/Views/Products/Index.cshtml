@model InventoryManagement.Web.ViewModels.ProductListModel
@{ ViewData["Title"] = "Products"; }
<div class="page-heading"><div><div class="eyebrow">INVENTORY OVERVIEW</div><h1>Products</h1><p class="text-secondary">Keep every product and stock movement in view.</p></div><a class="btn btn-primary" asp-action="Create">+ Add product</a></div>
<section class="panel"><div class="panel-toolbar"><div><h2>Product directory</h2><span class="text-secondary small">@Model.Products.Count results · stock calculated from movements</span></div>
<form method="get" class="d-flex gap-2" role="search"><label class="visually-hidden" for="search">Search SKU or name</label><input id="search" name="search" value="@Model.Search" class="form-control" placeholder="Search SKU or name…" maxlength="200" /><button class="btn btn-outline-primary">Search</button>@if (!string.IsNullOrEmpty(Model.Search)) { <a asp-action="Index" class="btn btn-light">Clear</a> }</form></div>
@if (Model.Products.Count == 0) { <div class="empty-state"><h3>No products found</h3><p>Try another search or add your first product.</p><a asp-action="Create" class="btn btn-primary">Add product</a></div> }
else { <div class="table-responsive"><table class="table align-middle mb-0"><thead><tr><th>Product / SKU</th><th class="text-end">Current stock</th><th class="text-end">Reorder level</th><th>Status</th><th><span class="visually-hidden">Actions</span></th></tr></thead><tbody>
@foreach (var p in Model.Products) { <tr class="@(p.IsLowStock ? "low-stock-row" : "")"><td><a class="product-name" asp-action="Details" asp-route-id="@p.Id">@p.Name</a><div class="sku">@p.Sku</div></td><td class="text-end"><strong>@p.CurrentStock.ToString("N0")</strong>@if (p.IsLowStock) { <span class="badge low-stock ms-2">Low stock</span> }</td><td class="text-end text-secondary">@p.ReorderLevel</td><td><span class="badge @(p.IsActive ? "active-badge" : "inactive-badge")">@(p.IsActive ? "Active" : "Inactive")</span></td><td class="text-end text-nowrap"><a asp-action="Details" asp-route-id="@p.Id" class="btn btn-sm btn-light">Details</a> <a asp-action="Edit" asp-route-id="@p.Id" class="btn btn-sm btn-outline-secondary">Edit</a></td></tr> }
</tbody></table></div> }</section>
