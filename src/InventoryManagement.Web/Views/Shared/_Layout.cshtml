<!DOCTYPE html>
<html lang="en"><head><meta charset="utf-8" /><meta name="viewport" content="width=device-width, initial-scale=1" />
<title>@ViewData["Title"] · Stockroom</title><link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" /><link rel="stylesheet" href="~/css/site.css" asp-append-version="true" /></head>
<body><a class="visually-hidden-focusable" href="#main">Skip to content</a><header class="topbar"><div class="container d-flex align-items-center justify-content-between gap-3"><a class="brand" asp-controller="Products" asp-action="Index"><span class="brand-icon">S</span> Stockroom<span class="brand-sub">INVENTORY MANAGER</span></a><a class="nav-link text-white" asp-controller="Products" asp-action="Index">Products</a></div></header>
<main id="main" class="container py-4 py-lg-5">@if (TempData["Success"] is string message) { <div class="alert alert-success" role="status">@message</div> }@RenderBody()</main>
<footer class="container py-4 text-secondary small border-top d-flex justify-content-between"><span>Stockroom / DevExcel assessment</span><span>Movement-based inventory · UTC</span></footer>
<script src="~/lib/jquery/dist/jquery.min.js"></script><script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script><script src="~/js/site.js" asp-append-version="true"></script>@await RenderSectionAsync("Scripts", required: false)</body></html>
