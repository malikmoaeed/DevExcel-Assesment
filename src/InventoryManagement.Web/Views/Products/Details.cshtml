@model InventoryManagement.Web.ViewModels.ProductDetailsModel
@using InventoryManagement.Domain.Enums
@{ ViewData["Title"] = Model.Product.Name; }
<a class="back-link" asp-action="Index">← All products</a>
<div class="page-heading"><div><div class="eyebrow">PRODUCT DETAILS <span class="heading-divider">/</span> @Model.Product.Sku</div><h1>@Model.Product.Name</h1><span class="badge @(Model.Product.IsActive ? "active-badge" : "inactive-badge")"><span class="badge-dot"></span>@(Model.Product.IsActive ? "Active" : "Inactive")</span></div><a asp-action="Edit" asp-route-id="@Model.Product.Id" class="btn btn-outline-primary"><svg class="icon" aria-hidden="true"><use href="/icons.svg#edit" /></svg>Edit product</a></div>
<div class="summary-grid">
    <section class="panel metric stock-metric"><div class="metric-heading"><span class="eyebrow">CURRENT STOCK</span><svg class="icon" aria-hidden="true"><use href="/icons.svg#layers" /></svg></div><div class="metric-value">@Model.Product.CurrentStock.ToString("N0") <small>units</small></div>@if (Model.Product.IsLowStock) { <span class="badge low-stock">Low stock · reorder recommended</span> } else { <span class="stock-healthy"><span class="status-dot"></span>Stock above reorder level</span> }</section>
    <section class="panel metric"><div class="metric-heading"><span class="eyebrow">REORDER LEVEL</span><svg class="icon" aria-hidden="true"><use href="/icons.svg#box" /></svg></div><div class="metric-value">@Model.Product.ReorderLevel <small>units</small></div><p class="metric-caption">Your threshold for replenishment</p></section>
    <section class="panel metric product-information"><div class="eyebrow">ABOUT THIS PRODUCT</div><p class="description">@(string.IsNullOrWhiteSpace(Model.Product.Description) ? "No description provided." : Model.Product.Description)</p><div class="metric-caption">Created @Model.Product.CreatedUtc.ToString("dd MMM yyyy") · UTC</div></section>
</div>
<div class="details-grid">
    <section class="panel history-panel">
        <div class="panel-toolbar"><div class="section-title"><span class="section-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#history" /></svg></span><div><h2>Movement history <span class="count-badge">@Model.History.Count</span></h2><p>A complete record of receipts and issues.</p></div></div></div>
        @if (Model.History.Count == 0)
        {
            <div class="empty-state"><span class="empty-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#history" /></svg></span><h3>No movements yet</h3><p>Record a Stock In to receive your first units.</p></div>
        }
        else
        {
            <div class="table-responsive" tabindex="0" role="region" aria-label="Stock movement history"><table class="table align-middle mb-0"><thead><tr><th scope="col">Date (UTC)</th><th scope="col">Movement</th><th scope="col" class="text-end">Quantity</th><th scope="col">Note</th></tr></thead><tbody>
            @foreach (var m in Model.History)
            {
                <tr><td class="text-nowrap"><div class="date-primary">@m.CreatedUtc.ToString("dd MMM yyyy")</div><div class="date-secondary">@m.CreatedUtc.ToString("HH:mm:ss")</div></td><td><span class="badge @(m.Type == MovementType.In ? "active-badge" : "out-badge")"><svg class="icon" aria-hidden="true"><use href="/icons.svg#@(m.Type == MovementType.In ? "arrow-in" : "arrow-out")" /></svg>Stock @m.Type</span></td><td class="text-end movement-quantity @(m.Type == MovementType.In ? "quantity-in" : "quantity-out")">@(m.Type == MovementType.In ? "+" : "−")@m.Quantity.ToString("N0")</td><td class="note">@(string.IsNullOrWhiteSpace(m.Note) ? "—" : m.Note)</td></tr>
            }
            </tbody></table></div><div class="table-footer"><span>Newest movements first</span><span>All times in UTC</span></div>
        }
    </section>
    <section class="panel movement-panel">
        <div class="panel-toolbar"><div><h2>Record movement</h2><p>Keep your stock up to date.</p></div><span class="section-icon"><svg class="icon" aria-hidden="true"><use href="/icons.svg#plus" /></svg></span></div>
        <div class="movement-body">
            <div asp-validation-summary="All" class="text-danger validation-panel" role="alert"></div>
            @if (Model.Product.IsActive)
            {
                <form asp-action="RecordMovement" asp-route-id="@Model.Product.Id" method="post" data-movement-form>
                    <input asp-for="Movement.RequestId" type="hidden" />
                    <fieldset class="mb-4"><legend class="form-label">Movement type <span class="required-mark" aria-hidden="true">*</span></legend><div class="movement-options">
                        <input asp-for="Movement.Type" type="radio" value="In" id="stockIn" class="btn-check" /><label class="movement-option in-option" for="stockIn"><svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-in" /></svg><strong>Stock In</strong><span>Receive goods</span></label>
                        <input asp-for="Movement.Type" type="radio" value="Out" id="stockOut" class="btn-check" /><label class="movement-option out-option" for="stockOut"><svg class="icon" aria-hidden="true"><use href="/icons.svg#arrow-out" /></svg><strong>Stock Out</strong><span>Issue goods</span></label>
                    </div><span asp-validation-for="Movement.Type" class="text-danger"></span></fieldset>
                    <div class="mb-4"><label asp-for="Movement.Quantity" class="form-label">Quantity <span class="required-mark" aria-hidden="true">*</span></label><div class="unit-input"><input asp-for="Movement.Quantity" class="form-control" min="1" /><span>units</span></div><span asp-validation-for="Movement.Quantity" class="text-danger"></span></div>
                    <div class="mb-4"><label asp-for="Movement.Note" class="form-label"></label><span class="optional-label">Optional</span><textarea asp-for="Movement.Note" class="form-control" rows="3" placeholder="Delivery or order reference"></textarea><span asp-validation-for="Movement.Note" class="text-danger"></span></div>
                    <button class="btn btn-primary w-100" type="submit"><svg class="icon" aria-hidden="true"><use href="/icons.svg#check" /></svg>Record movement</button><p class="form-footnote">Every saved movement stays in your history.</p>
                </form>
            }
            else { <div class="alert alert-secondary">This product is inactive. Reactivate it to record stock movements.</div><a asp-action="Edit" asp-route-id="@Model.Product.Id" class="btn btn-outline-primary w-100">Edit product status</a> }
        </div>
    </section>
</div>
@section Scripts { <partial name="_ValidationScriptsPartial" /> }
